# ==============================================================================
# INTERCEPT — Environment Configuration (.env.example)
# ==============================================================================
# NOTE: All deterministic verifiers (`npm test`, `npm run verify`, `npm run preflight`,
# and `npm run dev`) work out-of-the-box with ZERO secret keys required.
# Populate these variables ONLY when executing a live Mainnet rescue (`npm run rescue:live`).

# 1. NEAR Policy Guardrail & Scoped Agent Function-Call Access Key (Mainnet)
POLICY_CONTRACT_ID="guardrail.intercept-defi.near"
NEAR_ACCOUNT_ID="tee-agent.intercept-defi.near"
# Scoped Function-Call Access Key (`ed25519:...`) restricted strictly to:
#   - `request_rescue_origin_leg`
#   - `request_rescue_destination_leg`
NEAR_PRIVATE_KEY=""
NEAR_RPC_URL="https://rpc.mainnet.near.org"

# 2. NEAR AI Cloud Verifiable Confidential Inference (`https://cloud-api.near.ai/v1`)
# Create an API key at https://cloud.near.ai to enable live Intel TDX + NVIDIA NRAS hardware attestation
NEAR_AI_CLOUD_BASE_URL="https://cloud-api.near.ai/v1"
NEAR_AI_CLOUD_MODEL="deepseek-ai/DeepSeek-V3.1"
NEAR_AI_CLOUD_API_KEY=""
# Optional: 32-byte hex Ed25519 secret seed for the TEE enclave receipt signer (64 hex chars).
# Defaults to domain-separated SHA-256("INTERCEPT_NEAR_AI_CLOUD_TEE_ENCLAVE_V1") -> pubkey ef03c6fb5128efac12f621f4496fd3b84aa00f3df130f925b82e5d24c2a3a054
TEE_ENCLAVE_SECRET_SEED_HEX=""

# 3. NEAR Intents 1-Click Swap API (`https://1click.chaindefuser.com`)
ONECLICK_API_URL="https://1click.chaindefuser.com"
# Optional Partner JWT (reduces solver fee from 25 bps to 1 bp on stablecoin routes)
ONECLICK_JWT=""

# 4. Solana Mainnet & Kamino Lend (`KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD`)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Optional: Your personal Solana EOA (`User_Solana_EOA`) to auto-discover your Kamino Obligation PDA
USER_SOLANA_WALLET_PUBKEY=""
# Optional: Explicit Kamino Obligation PDA address override (defaults to verified live Solana Mainnet SOL/USDC Obligation)
USER_KAMINO_OBLIGATION_PUBKEY="C5dZVpvpA39SNLDkojsi98nRePRRy8ELhtxak8m2vMq"

# 5. Base Mainnet (`Chain ID 8453`)
BASE_RPC_URL="https://mainnet.base.org"
